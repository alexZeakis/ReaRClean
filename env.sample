# ReaRClean configuration. Copy to .env and edit.
# Every setting below has a working default, so an empty .env is valid.
# .env is gitignored; .env.sample is not. Never put a real key in this file.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Prefilled into the Token field in the frontend, which stays editable.
OPENAI_API_KEY=

# Any endpoint speaking the OpenAI protocol, so a locally served model works
# by pointing REARCLEAN_ENDPOINT at it.
REARCLEAN_MODEL=gpt-4o-mini
REARCLEAN_ENDPOINT=https://api.openai.com/v1/

REARCLEAN_MAX_TOKENS=4096
REARCLEAN_LLM_TIMEOUT=60
REARCLEAN_LLM_RETRIES=2

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Loopback by default: the service executes generated code, so set 0.0.0.0
# only on a network you trust.
REARCLEAN_HOST=127.0.0.1
REARCLEAN_PORT=8000
REARCLEAN_MAX_UPLOAD_MB=256

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Leave REARCLEAN_BACKEND empty to build the URL from the host and port above.
# Set it when the backend runs somewhere else.
REARCLEAN_BACKEND=
REARCLEAN_REQUEST_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Code generation and execution
# ---------------------------------------------------------------------------
# Regenerations before a function is abandoned, and the wall-clock cap on each
# generated function.
REARCLEAN_TRIES=10
REARCLEAN_FUNC_TIMEOUT=60

# Candidate paths above which the Path ordering stops searching exhaustively
# and selects greedily by weight.
REARCLEAN_EXACT_SEARCH_LIMIT=20
